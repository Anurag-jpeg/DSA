class Solution:
    def levelOrder(self, root: TreeNode | None) -> list[list[int]]:
        arr=[]
        
        def dfs(node,level):
            if not node:
                return 
            
            if level==len(arr):
                arr.append([])
            
            arr[level].append(node.val)

            dfs(node.left,level+1)
            dfs(node.right,level+1)
        dfs(root,0)
        return arr
