class Solution:
    def goodNodes(self, root: TreeNode) -> int:
        self.res=0

        def dfs(root,maxval):
            if root==None:
                return 0
            if root.val>=maxval:
                self.res+=1
            maxval=max(maxval,root.val)

            dfs(root.left,maxval)
            dfs(root.right,maxval)

        dfs(root,root.val)
        return self.res
