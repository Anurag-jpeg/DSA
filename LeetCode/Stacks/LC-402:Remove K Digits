class Solution:
    def removeKdigits(self, num: str, k: int) -> str:
        stack=[]
        c=0
        
        for x in num:
            
            while stack and stack[-1]>x and c<k:
                c+=1
                stack.pop()
            stack.append(x)
        
        while c<k:
            stack.pop()
            c+=1
            
        ans="".join(stack).lstrip('0')
        return ans if ans else '0'

        
