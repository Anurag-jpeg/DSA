class Solution:
    def dailyTemperatures(self, temperatures: List[int]) -> List[int]:
        stack=[]
        ans=[0]*len(temperatures)

        for i,x in enumerate(temperatures):
            while stack and x>stack[-1][0]:
                stackT,stackInd=stack.pop()
                ans[stackInd]=(i-stackInd)
            stack.append([x,i])
        return ans
