class Solution:
    def asteroidCollision(self, asteroids: List[int]) -> List[int]:
        stack=[]
        
        for x in asteroids:

            while stack and stack[-1]>0 and x<0 and abs(stack[-1])<abs(x):
                stack.pop()
            
            if stack and stack[-1]>0 and x<0 :
                if abs(stack[-1])==abs(x):
                    stack.pop()
            else:
                stack.append(x)

        return stack
